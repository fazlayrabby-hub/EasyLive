<Window x:Class="EasyLive.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyLive" Icon="Assets/EasyLive.ico" Width="500" Height="1010" MinWidth="480" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanMinimize" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}" FontSize="15" Foreground="{StaticResource TextBrush}">
    <Border Margin="14" CornerRadius="22" Background="{StaticResource WindowBackground}"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="28" ShadowDepth="0" Opacity="0.35"/></Border.Effect>
        <Grid>
        <!-- Alert backgrounds: crimson while live, amber while reconnecting (fade 400 ms) -->
        <Border IsHitTestVisible="False" CornerRadius="21" Opacity="0"
                BorderBrush="#FF5C74" BorderThickness="3">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#3B0A14" Offset="0"/>
                    <GradientStop Color="#8B1020" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Live">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="liveIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                                        <DoubleAnimation Storyboard.TargetProperty="BorderBrush.Opacity" From="1" To="0.25"
                                                         Duration="0:0:0.9" RepeatBehavior="Forever" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="liveIn"/>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Border IsHitTestVisible="False" CornerRadius="21" Opacity="0"
                BorderBrush="#FBBF24" BorderThickness="1.5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2E1F06" Offset="0"/>
                    <GradientStop Color="#6B4A0C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Reconnecting">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="recIn">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="0.9" Duration="0:0:0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="recIn"/>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="0" Duration="0:0:0.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown" Margin="20,10,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="24" Height="24" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="EasyLive logo"/>
                    <TextBlock Text="EASYLIVE" FontWeight="Bold" FontSize="14">
                        <TextBlock.Foreground>
                            <StaticResource ResourceKey="NeonBrush"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="by sohan roni" FontSize="10.5" Foreground="#B4BDDB" Opacity="0.85"
                               Margin="8,0,0,2.5" VerticalAlignment="Bottom"/>
                </StackPanel>
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Padding="10,3"
                        BorderThickness="1" AutomationProperties.Name="On air indicator">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Background" Value="#CCF43F5E"/>
                            <Setter Property="BorderBrush" Value="#FFA3B1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Live">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Reconnecting">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Background" Value="#CCB7791F"/>
                                    <Setter Property="BorderBrush" Value="#FDE68A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock FontWeight="Bold" FontSize="12" Foreground="White">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="ON AIR"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Reconnecting">
                                            <Setter Property="Text" Value="RECONNECTING"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleButton}" Click="Minimize_Click" ToolTip="Minimize"
                            AutomationProperties.Name="Minimize">
                        <Rectangle Width="12" Height="2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="Close"
                            AutomationProperties.Name="Close">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,6,28,16">
                <!-- Step 1 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="1  ·  WHAT DO YOU WANT TO SHARE?" Style="{StaticResource CardTitle}"/>
                        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                                  IsEnabled="{Binding CanEdit}"
                                  Style="{StaticResource NeonCombo}" AutomationProperties.Name="What to share">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Margin="2,8,0,0" FontSize="13">
                            <Hyperlink Click="Refresh_Click">Refresh the list</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Step 2 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="2  ·  WHERE ARE YOU STREAMING?" Style="{StaticResource CardTitle}"/>
                        <Border Background="#66070B1A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="20"
                                HorizontalAlignment="Left" Padding="2">
                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEdit}">
                                <RadioButton Content="YouTube" IsChecked="{Binding IsYouTube}" GroupName="p"
                                             Style="{StaticResource PillRadio}" Tag="{StaticResource YouTubeBrush}"/>
                                <RadioButton Content="Facebook" IsChecked="{Binding IsFacebook}" GroupName="p"
                                             Style="{StaticResource PillRadio}" Tag="{StaticResource FacebookBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Step 3 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="3  ·  YOUR STREAM KEY" Style="{StaticResource CardTitle}"/>
                        <TextBox x:Name="KeyBox" Text="{Binding StreamKey, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEdit}" Style="{StaticResource NeonTextBox}"
                                 AutomationProperties.Name="Stream key"/>
                        <TextBlock Text="{Binding KeyHint}" Foreground="#FBBF24" FontSize="13" TextWrapping="Wrap" Margin="2,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasKeyHint}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="2,8,0,0" FontSize="13" TextWrapping="Wrap">
                            <Hyperlink Click="Help_Click">Where do I find this?</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource GoLiveButton}" Command="{Binding GoLiveCommand}"
                        AutomationProperties.Name="Go Live">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Go Live"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                        <Setter Property="Text" Value="YOU'RE LIVE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- Status -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StateDot}" Margin="0,2,12,0"/>
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="16" MinHeight="44"
                                       MaxWidth="360" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <TextBlock Text="{Binding QualityText}" Foreground="{StaticResource CyanBrush}" FontSize="13"
                                   Margin="24,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Stream settings -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <TextBlock Text="STREAM SETTINGS" Style="{StaticResource CardTitle}"/>
                        <ItemsControl ItemsSource="{Binding DetailRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="L"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="13"
                                                   Margin="0,0,16,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" TextWrapping="Wrap"
                                                   FontFamily="Cascadia Mono, Consolas"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding DetailsHint}" Foreground="{StaticResource CyanBrush}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource StopButton}"
                        AutomationProperties.Name="Stop"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Center">
                    <Button Content="Mute microphone" Command="{Binding MuteMicCommand}"
                            Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                    <Button Content="Mute game sound" Command="{Binding MuteSystemCommand}"
                            Style="{StaticResource GhostButton}"/>
                </StackPanel>
                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" FontSize="13" HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value=""/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MicMuted}" Value="True">
                                    <Setter Property="Text" Value="Your microphone is muted."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="13" HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value=""/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SystemMuted}" Value="True">
                                    <Setter Property="Text" Value="Game sound is muted."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
    </Border>
</Window>










