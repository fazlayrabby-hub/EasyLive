<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette -->
    <Color x:Key="CyanColor">#22D3EE</Color>
    <Color x:Key="VioletColor">#8B5CF6</Color>
    <Color x:Key="MagentaColor">#EC4899</Color>
    <Color x:Key="GreenColor">#34D399</Color>
    <Color x:Key="AmberColor">#FBBF24</Color>
    <Color x:Key="RedColor">#F43F5E</Color>

    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}"/>
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EEF1FB"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A3AED0"/>
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2AFFFFFF"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#CC070B1A"/>
    <SolidColorBrush x:Key="PopupBrush" Color="#FF0D1330"/>

    <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#05070F" Offset="0"/>
        <GradientStop Color="#0B1030" Offset="0.6"/>
        <GradientStop Color="#1A0B33" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NeonBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource CyanColor}" Offset="0"/>
        <GradientStop Color="{StaticResource VioletColor}" Offset="0.55"/>
        <GradientStop Color="{StaticResource MagentaColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NeonHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#67E8F9" Offset="0"/>
        <GradientStop Color="#A78BFA" Offset="0.55"/>
        <GradientStop Color="#F472B6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiveBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#10B981" Offset="0"/>
        <GradientStop Color="#22D3EE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="YouTubeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4D6A" Offset="0"/>
        <GradientStop Color="#E0102F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FacebookBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4C9AFF" Offset="0"/>
        <GradientStop Color="#1766E0" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Glass card -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="18,14"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Title bar buttons -->
    <Style x:Key="TitleButton" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E5F43F5E"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small ghost button (mute) -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="#14FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                            CornerRadius="12" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Go Live: glowing neon gradient; pulsing green glow while live -->
    <Style x:Key="GoLiveButton" TargetType="Button">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="84"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,2,0,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="halo" Background="#8B5CF6" CornerRadius="22" Opacity="0.55" Margin="4">
                            <Border.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="36" ShadowDepth="0" Opacity="1"/></Border.Effect>
                        </Border>
                        <Border x:Name="glow" Background="{StaticResource NeonBrush}" CornerRadius="22" RenderTransformOrigin="0.5,0.5"/>
                        <Border x:Name="shine" CornerRadius="22" Margin="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="glow" Property="Background" Value="{StaticResource NeonHoverBrush}"/>
                            <Setter TargetName="halo" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="glow" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="glow" Property="Background" Value="#2B3350"/>
                            <Setter TargetName="halo" Property="Opacity" Value="0"/>
                            <Setter TargetName="shine" Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Foreground" Value="#8E98BA"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                            <Setter TargetName="glow" Property="Background" Value="{StaticResource LiveBrush}"/>
                            <Setter TargetName="halo" Property="Background" Value="#22D3EE"/>
                            <Setter TargetName="shine" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="White"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="pulse">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="halo" Storyboard.TargetProperty="Opacity"
                                                         From="0.3" To="1" Duration="0:0:1.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="pulse"/>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Stop: magenta/red outline that fills on hover -->
    <Style x:Key="StopButton" TargetType="Button">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#FF8FB3"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="halo" Background="#F43F5E" CornerRadius="14" Opacity="0.25" Margin="3">
                            <Border.Effect><DropShadowEffect Color="#F43F5E" BlurRadius="18" ShadowDepth="0" Opacity="1"/></Border.Effect>
                        </Border>
                        <Border x:Name="bd" Background="#E6150A1E" BorderBrush="#F43F5E" BorderThickness="1.5" CornerRadius="14"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E5F43F5E"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="halo" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="#0DFFFFFF"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#33FFFFFF"/>
                            <Setter TargetName="halo" Property="Opacity" Value="0"/>
                            <Setter Property="Foreground" Value="#7C87AB"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pill toggle: Tag carries the brand brush used when checked -->
    <Style x:Key="PillRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="16" Padding="22,8" Margin="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text box with focus glow -->
    <Style x:Key="NeonTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource CyanBrush}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="halo" Background="#22D3EE" CornerRadius="12" Opacity="0" Margin="3">
                            <Border.Effect><DropShadowEffect Color="#22D3EE" BlurRadius="16" ShadowDepth="0" Opacity="1"/></Border.Effect>
                        </Border>
                        <Border x:Name="bd" Background="#F0070B1A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#668B5CF6"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                            <Setter TargetName="halo" Property="Opacity" Value="0.35"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Combo box -->
    <Style x:Key="NeonComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="2,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#338B5CF6"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#4422D3EE"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NeonCombo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource NeonComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border x:Name="halo" Background="#22D3EE" CornerRadius="12" Opacity="0" Margin="3">
                                            <Border.Effect><DropShadowEffect Color="#22D3EE" BlurRadius="16" ShadowDepth="0" Opacity="1"/></Border.Effect>
                                        </Border>
                                        <Border x:Name="bd" Background="#F0070B1A" BorderBrush="#33FFFFFF"
                                                BorderThickness="1" CornerRadius="12" Padding="12,10">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Data="M0,0 L5,5 L10,0"
                                                  Stroke="{StaticResource CyanBrush}" StrokeThickness="2" Margin="0,0,2,0"/>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#668B5CF6"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                                            <Setter TargetName="halo" Property="Opacity" Value="0.35"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="12,10,34,10" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          TextElement.Foreground="{StaticResource TextBrush}"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource PopupBrush}" BorderBrush="#4D8B5CF6" BorderThickness="1"
                                    CornerRadius="12" Margin="0,6,0,12" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="260">
                                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/></Border.Effect>
                                <ScrollViewer><StackPanel IsItemsHost="True"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Links -->
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
        <Setter Property="TextDecorations" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#A5F3FC"/>
                <Setter Property="TextDecorations" Value="Underline"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Status dot -->
    <Style x:Key="StateDot" TargetType="Ellipse">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Fill" Value="#7C87AB"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Effect">
            <Setter.Value><DropShadowEffect Color="#7C87AB" BlurRadius="10" ShadowDepth="0" Opacity="0.0"/></Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Checking">
                <Setter Property="Fill" Value="{StaticResource AmberBrush}"/>
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="chk"><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.6"/></Storyboard></BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="chk"/></DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Reconnecting">
                <Setter Property="Fill" Value="{StaticResource AmberBrush}"/>
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="rec"><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.6"/></Storyboard></BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="rec"/></DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Live">
                <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="liv"><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.9"/></Storyboard></BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="liv"/></DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Failed">
                <Setter Property="Fill" Value="{StaticResource RedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>





